name: Build DOOV R17 APK

on:
  workflow_dispatch:
  push:
    paths:
      - '**'

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - uses: gradle/actions/setup-gradle@v4

      - name: Build APK
        working-directory: DOOV_R17_Launcher
        run: gradle assembleDebug

      - uses: actions/upload-artifact@v4
        with:
          name: DOOV-R17-APK
          path: DOOV_R17_Launcher/app/build/outputs/apk/debug/*.apk
